        }
      ]
    },
    "toDecision": {
      "domain": [
        "Applicability"
      ],
      "range": [
        "Decision"
      ],
      "definition": "Names the current decision targeted by an applicability assessment.",
      "bookSources": [
        {
          "path": "book/ua/10-method.md",
          "section": 3
        }
      ]
    },
    "adoptsRevision": {
      "domain": [
        "Decision"
      ],
      "range": [
        "Revision"
