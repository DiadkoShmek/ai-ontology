        }
      ]
    },
    "describedBy": {
      "domain": [
        "Actor",
        "Model",
        "Profile",
        "Session",
        "Orientation",
        "Scope",
        "Criterion",
        "Claim",
        "Observation",
        "Decision",
        "Effect",
        "Lesson",
        "Objection",
        "Revision",
        "Assessment",
        "Authority",
        "Applicability",
        "ActionCandidate"
      ],
      "range": [
        "Observation"
      ],
      "definition": "Links a record to its descriptive source material, without claiming entailment, availability to a model or actual use.",
