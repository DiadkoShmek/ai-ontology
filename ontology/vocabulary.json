      ],
      "range": [
        "Authority"
      ],
      "definition": "Names the warrant recorded for this acceptance or action. No permission is inferred from a correction.",
      "bookSources": [
        {
          "path": "book/ua/10-method.md",
          "section": 3
        }
      ]
    },
    "heldBy": {
      "domain": [
        "Authority"
      ],
      "range": [
        "Actor"
      ],
      "definition": "Names the actor to whom this warrant is attributed.",
      "bookSources": [
        {
          "path": "book/ua/10-method.md",
          "section": 3
        }
      ]
    },
    "grantedBy": {
      "domain": [
        "Authority"
      ],
      "range": [
        "Actor"
      ],
      "definition": "Names the purported grantor; independent authentication is outside this finite graph.",
      "bookSources": [
        {
          "path": "book/ua/10-method.md",
          "section": 3
        }
      ]
    },
    "challenges": {
